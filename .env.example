# Telegram token from BotFather. Never commit the real .env.
TELEGRAM_TRANSCRIBE_BOT_TOKEN=
# Required unless TELEGRAM_TRANSCRIBE_ALLOW_PUBLIC=true (cost and abuse risk).
TELEGRAM_TRANSCRIBE_OWNER_IDS=123456789
TELEGRAM_TRANSCRIBE_ALLOW_PUBLIC=false

# Audio is sent to OpenAI only for incoming voice/audio messages.
OPENAI_API_KEY=
TRANSCRIBE_MODE=auto
TRANSCRIBE_MODEL=gpt-transcribe
TRANSCRIBE_EDIT=humanizer

# auto: use Humanizer's GLM provider when ZAI_API_KEY exists; otherwise
# use the direct OpenAI text adapter if OPENAI_API_KEY exists.
# framework: use Humanizer Framework's full native provider chain.
# openai: use the direct OpenAI text adapter through Humanizer Framework.
HUMANIZER_BACKEND=auto
HUMANIZER_OPENAI_MODEL=gpt-4.1-mini
ZAI_API_KEY=
HUMANIZER_TELEMETRY=0

# bot_api (default) needs no Telethon. mtproto requires requirements-mtproto.txt
TELEGRAM_TRANSCRIBE_TRANSPORT=bot_api
TRANSCRIBE_TG_API_ID=
TRANSCRIBE_TG_API_HASH=
TRANSCRIBE_MT_PROTO_SESSION=bot-mtproto
